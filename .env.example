# --- Database ---
# SQLite by default (zero setup). For production you can switch to Postgres/MySQL
# by changing prisma/schema.prisma's datasource provider + this URL.
DATABASE_URL="file:./dev.db"

# --- Admin access ---
# The secret "code" an admin types in to unlock admin features.
# CHANGE THIS to a long random value before deploying.
ADMIN_ACCESS_CODE="change-this-to-a-long-secret-code"

# The URL path where the admin login lives. It is NOT linked from anywhere in
# the UI, is not guessable, and returns a normal 404 to anyone who does not
# know it. Change this per deployment. Do not use anything like "admin" or
# "login" here — pick something random, e.g. "gatekeeper-7f2c91".
ADMIN_ROUTE_SECRET="gatekeeper-7f2c91"

# Used to sign the admin session cookie (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET="change-this-too-generate-a-random-64-char-hex-string"

# How long an admin session stays valid, in hours.
ADMIN_SESSION_HOURS=8
