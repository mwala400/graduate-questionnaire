# --- Database ---
# A Postgres connection string. Works locally and on Vercel (SQLite's local
# file does not survive Vercel's serverless filesystem between requests).
# Free options that work great with this project: Neon (neon.tech),
# Supabase, or Vercel Postgres (from your Vercel project's Storage tab).
# Example (Neon):
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Admin access ---
# You do NOT have to fill these in by hand: if you leave them blank and
# run `npm run dev` (or `npm start`), the app will generate them for you
# automatically, print them in the terminal every time it starts, and save
# them to .env.local so they don't change between restarts.
#
# For a Vercel deployment, generate them ahead of time with:
#   npm run generate:admin
# then paste the printed values into Vercel's Project Settings ->
# Environment Variables (Vercel's filesystem is read-only, so the app
# cannot auto-generate and persist them there the way it does locally).
#
# Format: one letter followed by digits, 8 characters total (e.g. K3948271).
ADMIN_ACCESS_CODE=""
ADMIN_ROUTE_SECRET=""

# Signs the admin session cookie. Also auto-generated if left blank.
ADMIN_SESSION_SECRET=""

# How long an admin session stays valid, in hours.
ADMIN_SESSION_HOURS=8
