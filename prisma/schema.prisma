generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Provider is chosen at install/push time from DATABASE_URL by
  // scripts/setup-prisma.js:
  //   - postgresql://... or postgres://...  -> postgresql (Vercel / production)
  //   - file:... or sqlite:...              -> sqlite    (local dev, zero setup)
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per submitted questionnaire, of any of the four types. Each
// type's fields differ enough (Employer's org profile, Professional's
// alumni table, etc.) that a single wide table of nullable columns would
// be unwieldy; instead `data` holds the type-specific payload as JSON,
// validated against lib/questionnaires/definitions.ts at read/write time.
model Response {
  id        String   @id @default(cuid())
  type      String // "graduate" | "society" | "employer" | "professional"
  createdAt DateTime @default(now())
  data      String // JSON-encoded payload matching that type's QuestionnaireDef

  @@index([type])
}

// Partially-completed questionnaires a respondent can save and resume later
// (the "Save Draft" button). Identical adaptive DB as Response, so it works
// on both local SQLite and hosted Postgres.
model Draft {
  id        String   @id @default(cuid())
  type      String // "graduate" | "society" | "employer" | "professional"
  data      String // JSON-encoded payload (may be partial)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}
